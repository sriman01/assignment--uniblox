PORT=4000

# Signs session cookies; at least 32 characters (openssl rand -hex 32). Required on Vercel.
SESSION_SECRET=

# Leave DB_HOST empty to run on the in-memory store.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# Optional: verify-full (default when DB_SSL_CA is set), require (encrypted, certificate not checked), or disable (local only).
DB_SSL_MODE=
# Path to the provider's CA certificate (e.g. ca.pem from the Aiven console), or the PEM text itself.
DB_SSL_CA=ca.pem
# Optional: Postgres schema to use (defaults to public).
DB_SCHEMA=
